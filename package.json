{
  "name": "datocms-plugin-netlify-forms",
  "version": "1.0.11",
  "private": false,
  "description": "Plugin that allows DatoCMS show and manage Netlify form submissions",
  "keywords": [
    "datocms",
    "datocms-plugin",
    "netlify"
  ],
  "homepage": "https://github.com/gempi/datocms-plugin-netlify-forms#readme",
  "author": "Matthias Wolgensinger <hello@matthiasgemperli.ch>",
  "repository": {
    "url": "https://github.com/gempi/datocms-plugin-netlify-forms"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "prepare": "simple-git-hooks",
    "typecheck": "tsc --noEmit",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "datocms-plugin-sdk": "^2.5.0",
    "datocms-react-ui": "^2.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-final-form": "^7.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "globals": "^17.13.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run fmt"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.0",
  "datoCmsPlugin": {
    "title": "Netlify Forms",
    "coverImage": "docs/cover.png",
    "previewImage": "docs/demo.mp4",
    "entryPoint": "dist/index.html",
    "permissions": []
  }
}
